{
  "name": "trakline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "dev:fixture": "PNR_SOURCE=fixture next dev",
    "dev:rapidapi": "PNR_SOURCE=rapidapi next dev",
    "dev:railkit": "PNR_SOURCE=railkit PNR_FALLBACK=rapidapi next dev",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:auth": "E2E_SUPABASE=1 playwright test",
    "test:all": "npm run test:unit && npm run test:e2e",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "screenshots": "SCREENSHOTS=1 playwright test tests/e2e/screenshots.spec.ts --project=desktop --project=mobile",
    "db:start": "npx supabase@2.117.0 start",
    "db:stop": "npx supabase@2.117.0 stop",
    "db:reset": "npx supabase@2.117.0 db reset",
    "db:push": "npx supabase@2.117.0 db push",
    "db:types": "npx supabase@2.117.0 gen types typescript --local --schema public > src/types/supabase.ts",
    "db:types:linked": "npx supabase@2.117.0 gen types typescript --linked --schema public > src/types/supabase.ts",
    "db:link": "npx supabase@2.117.0 link --project-ref xnykpktqtimadelfjgqf",
    "db:config:diff": "npx supabase@2.117.0 config diff",
    "db:config": "npx supabase@2.117.0 config push",
    "db:migration": "npx supabase@2.117.0 migration new",
    "source:probe": "node --env-file=.env.local scripts/probe-rapidapi.mjs",
    "source:probe:railkit": "node --env-file=.env.local scripts/probe-railkit.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fluentui/react-icons": "^2.0.339",
    "@sentry/nextjs": "10.75.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@upstash/ratelimit": "2.1.0",
    "@upstash/redis": "1.38.4",
    "clsx": "2.1.1",
    "motion": "13.4.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents": false,
    "@sentry/cli@2.58.6": true
  }
}
