# ---- Data source -----------------------------------------------------------
# live (default) | railkit | rapidapi | fixture.
#   railkit  reads RailKit (railkit.in) over its REST API, https://api.railkit.in. A third party,
#            NOT affiliated with IRCTC or Indian Railways and not an official source: every result
#            is tagged "Third-party" and names it. Commercial use needs a paid RailKit plan.
#            Confirm the response shape with `npm run source:probe:railkit -- <your PNR>`.
#   fixture  serves deterministic, clearly labelled SAMPLE data and is refused when
#            NODE_ENV=production. Put PNR_SOURCE=fixture in .env.development.local
#            (never .env.local) so `next build` is unaffected.
#   rapidapi reads the RapidAPI "IRCTC" API by IRCTCAPI (irctc1.p.rapidapi.com).
#            A third party, NOT affiliated with IRCTC or Indian Railways, and not a
#            verified source: every result is tagged "Third-party" and names it.
#            Check the provider's terms before production use. Confirm the response
#            shape with `npm run source:probe -- <your PNR>` (prints field names only).
PNR_SOURCE=live
# none (default) | railkit | rapidapi: a second third-party source, asked only while PNR_SOURCE is
# unavailable (never on "no record"). Its answers are labelled with its own name.
PNR_FALLBACK=none
LIVE_SOURCE_ENABLED=0
# Server only. Never expose with a NEXT_PUBLIC_ prefix. Required when RailKit is the source or fallback.
# A dashboard key (railkit_…). Regenerate it at once if it is ever pasted anywhere public.
RAILKIT_API_KEY=
RAILKIT_BASE_URL=https://api.railkit.in
RAILKIT_TIMEOUT_MS=8000
# Server only. Never expose with a NEXT_PUBLIC_ prefix. Required when RapidAPI is the source or fallback.
RAPIDAPI_KEY=
RAPIDAPI_HOST=irctc1.p.rapidapi.com
RAPIDAPI_PNR_PATH=/api/v3/getPNRStatus
RAPIDAPI_TIMEOUT_MS=8000

# ---- Shared store: rate limits and the PNR cache ----------------------------
# auto (default): Upstash when the URL, token and DATA_KEY are all set, memory otherwise.
# Deployments (VERCEL_ENV production/preview) refuse to boot without the shared store.
RATE_LIMIT_STRATEGY=auto
# Vercel's Upstash integration injects KV_REST_API_URL / KV_REST_API_TOKEN; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Server only. 32 random bytes: openssl rand -base64 32. Rotating it empties the cache.
DATA_KEY=

# ---- Supabase (accounts + synced watchlist) ---------------------------------
# Hosted: Dashboard > Project Settings > API Keys. Local stack (`npm run db:start`):
# `npx supabase@2.117.0 status -o env` (its ANON_KEY also works as the publishable key).
# https://<project-ref>.supabase.co, or http://127.0.0.1:54321 for the local stack. Set with the key, or neither.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Browser-safe: row-level security guards the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server only, never NEXT_PUBLIC_. Used solely to delete an account.
SUPABASE_SECRET_KEY=
# 1 shows "Continue with Google". Enable the Google provider in Supabase first.
AUTH_GOOGLE_ENABLED=0
# 1 offers passkeys (sign in, and manage them on the account). Enable passkeys in Supabase first.
AUTH_PASSKEY_ENABLED=0

# ---- Optional ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Used only by `supabase config push` / hosted provisioning ---------------
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_DB_PASSWORD=
