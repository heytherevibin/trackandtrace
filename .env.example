# ---- Data source -----------------------------------------------------------
# live (default) | fixture. fixture serves deterministic, clearly labelled SAMPLE
# data and is refused when NODE_ENV=production. Put PNR_SOURCE=fixture in
# .env.development.local (never .env.local) so `next build` is unaffected.
PNR_SOURCE=live
LIVE_SOURCE_ENABLED=0

# ---- Rate limiting: memory (per instance) | upstash (shared) ----------------
RATE_LIMIT_STRATEGY=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Supabase (accounts + synced watchlist). Local stack: `npm run db:start` ---
# Get local values with `npx supabase@2.117.0 status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Optional ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Used only by `supabase config push` / hosted provisioning ---------------
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_DB_PASSWORD=
