# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the template
!.env.example
.impeccable/review/
test-results/
playwright-report/
.env.supabase.local
supabase/.temp/

# local agent/tooling scrap
.freebuff/
.claude-flow/
.impeccable/questions/

# where the availability crawler's rolling window got to: this machine's record of what it has
# asked, not source. Deleting it costs a sweep; committing it would put two operators in conflict.
scripts/crawl-cursor.json

# agent worktrees
/.claude/worktrees/

# the subagent-driven-development workspace: ledgers, briefs, reports and review packages for
# in-flight plans. Scratch for whoever is running the plan, never source. It was untracked rather
# than ignored until now, so one `git add -A` would have committed every internal review note.
/.superpowers/
